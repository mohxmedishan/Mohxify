<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">\n    <uses-permission android:name="android.permission.INTERNET" />\n    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_mohxify_launcher"
        android:label="Mohxify"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".MohxifyAccessibilityService"
            android:label="Mohxify text replacement"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"\n            android:icon="@drawable/ic_mohxify_launcher"
            android:exported="false">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/mohxify_accessibility_service" />
        </service>
        <service
            android:name=".MohxifyTileService"
            android:label="Mohxify"
            android:icon="@android:drawable/ic_menu_edit"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"\n            android:icon="@drawable/ic_mohxify_launcher"
            android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver\n            android:name=".UpdateInstallReceiver"\n            android:exported="false" />\n    </application>
</manifest>